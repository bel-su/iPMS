# Local object storage for developers without Cloudflare R2 keys.
#
# Copy to media.secrets.env (same folder) and start the stack with the MinIO
# container switched on:
#
#   docker compose -f docker/docker-compose.yml --profile local-storage up -d
#
# Never use this on staging or production. Those use media.secrets.env.example (R2).

S3_ENDPOINT=http://minio:9000
# The host baked into presigned links: what your browser/phone can reach.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ipms-media-local
S3_ACCESS_KEY_ID=ipms_media
S3_SECRET_ACCESS_KEY=ipms_media_local_secret
S3_FORCE_PATH_STYLE=true
# Local only: media creates this bucket in MinIO at start.
S3_AUTO_CREATE_BUCKET=true
