# Cloudflare R2 credentials for the media service.
#
# Copy to media.secrets.env (same folder) and fill in the values.
# media.secrets.env is gitignored and must never be committed.
# Compose loads it after media.env, so these values replace the local MinIO ones.
# All eight values are required.
#
# Where to find them in the Cloudflare dashboard (the iPMS account):
#   <account-id>          R2 Object Storage -> Overview -> Account details -> Account ID
#   S3_ACCESS_KEY_ID      shown once when you create the R2 API token
#   S3_SECRET_ACCESS_KEY  shown once when you create the R2 API token
# The token must be an Account API token with "Object Read & Write",
# scoped to this one bucket only, and with no client IP filtering.

S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The host baked into presigned upload/view links. For R2 it is the same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# Local development and staging use the staging bucket; only production uses ipms-media-prod.
S3_BUCKET=ipms-media-staging
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=false
# R2 tokens cannot create buckets; the buckets were created in the dashboard.
S3_AUTO_CREATE_BUCKET=false
