# syntax=docker/dockerfile:1.7

FROM node:22-slim AS base
RUN npm install -g pnpm@10.15.0
WORKDIR /app

FROM base AS build-deps
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm -r --filter "./libs/*" build

FROM build-deps AS build
ARG SERVICE

# Prisma generates into `apps/$SERVICE/node_modules/@prisma-clients/$SERVICE`,
# so it must run before the service is compiled against those types.
RUN if [ -f "apps/$SERVICE/prisma/schema.prisma" ]; then \
      DATABASE_URL="postgresql://dummy" pnpm --filter "$SERVICE" exec prisma generate; \
    fi
RUN pnpm --filter "$SERVICE" build

# `deploy` resolves this service's production dependency graph — including the
# workspace libraries, copied in with their built output — into one
# self-contained tree with a plain node_modules and no symlinks out of it.
RUN pnpm --filter "$SERVICE" deploy --prod --legacy /deploy

# `deploy` builds node_modules from the lockfile, which does not describe the
# generated Prisma client, so it is carried over separately.
RUN if [ -d "apps/$SERVICE/node_modules/@prisma-clients" ]; then \
      cp -R "apps/$SERVICE/node_modules/@prisma-clients" /deploy/node_modules/; \
    fi

# Migrations run as their own one-shot container, from the build stage, which
# still has the dev dependencies the runtime image prunes — the Prisma CLI
# among them. Kept out of the service's own startup on purpose: several
# replicas booting at once would race each other to apply the same migration.
FROM build AS migrate
ARG SERVICE
ENV SERVICE=$SERVICE
WORKDIR /app/apps/$SERVICE
CMD ["sh", "-c", "pnpm exec prisma migrate deploy"]

FROM base AS runtime
ENV NODE_ENV=production
RUN groupadd -r ipms && useradd -r -g ipms ipms
COPY --from=build --chown=ipms:ipms /deploy ./
USER ipms
EXPOSE 3000
# Every service compiles to the same layout, so this needs no build argument at
# runtime — the missing `ENV SERVICE` is what made the previous image exit with
# `Cannot find module '/app/dist/apps/src/main.js'`.
CMD ["node", "dist/src/main.js"]
