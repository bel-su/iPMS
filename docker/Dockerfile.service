# syntax=docker/dockerfile:1.7
ARG SERVICE

FROM node:22.13-alpine AS base
RUN npm install -g pnpm@10.15.0
WORKDIR /app

FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY libs ./libs
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG SERVICE
COPY . .
RUN pnpm nx build "$SERVICE" --configuration=production
RUN if [ -f "apps/$SERVICE/prisma/schema.prisma" ]; then pnpm --filter "$SERVICE" exec prisma generate; fi

FROM base AS runtime
ARG SERVICE
ENV NODE_ENV=production
RUN addgroup -S ipms && adduser -S ipms -G ipms
COPY --from=build --chown=ipms:ipms /app/dist/apps/$SERVICE ./dist
COPY --from=build --chown=ipms:ipms /app/node_modules ./node_modules
COPY --from=build --chown=ipms:ipms /app/apps/$SERVICE/prisma ./prisma
USER ipms
EXPOSE 3000
CMD ["node", "dist/main.js"]
