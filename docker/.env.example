LOG_LEVEL=info
JWT_SECRET=super_secret_jwt_key_for_local_dev
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
POSTGRES_PASSWORD=postgres_local_dev_password
COOKIE_SECRET=super_secret_cookie_key_for_local_dev
CORS_ORIGINS=http://localhost:3100
GATEWAY_PORT=3000
WEB_PORT=3100

# Creates the four demo accounts (admin, manager, qc, engineer), all sharing
# this password, when the stack starts. Leave it unset and the iam bootstrap
# only reconciles the permission catalog and the system roles, creating no
# credentials. Local development only.
# IAM_DEMO_PASSWORD=ipms-dev-password
