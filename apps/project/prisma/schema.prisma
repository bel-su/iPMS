generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma-clients/project"
}
datasource db {
  provider = "postgresql"
}

model Project {
  id String @id @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(200)
  clientName String? @map("client_name") @db.VarChar(200)
  phase String? @db.VarChar(100)
  status String @default("DRAFT") @db.VarChar(30)
  defaultGeofenceRadiusM Int? @default(500)
  startDate DateTime? @db.Date
  targetDate DateTime? @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  regions Region[]
  sites Site[]
  taskTypes TaskType[]
  milestones Milestone[]
  tasks Task[]
  @@map("project")
}
model Region {
  id String @id @db.Uuid
  projectId String @db.Uuid
  name String @db.VarChar(150)
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  sites Site[]
  @@unique([projectId,name])
  @@map("region")
}
model Site {
  id String @id @db.Uuid
  projectId String @db.Uuid
  regionId String? @db.Uuid
  siteCode String @db.VarChar(50)
  name String @db.VarChar(200)
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  geofenceMode String @default("INHERIT") @db.VarChar(10)
  geofenceRadiusM Int?
  address String? @db.VarChar(500)
  city String? @db.VarChar(100)
  area String? @db.VarChar(100)
  scopeVariant String? @db.VarChar(100)
  status String @default("PLANNED") @db.VarChar(30)
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  region Region? @relation(fields:[regionId],references:[id],onDelete:SetNull)
  tasks Task[]
  @@unique([projectId,siteCode])
  @@map("site")
}
model TaskType {
  id String @id @db.Uuid
  projectId String @db.Uuid
  code String @db.VarChar(50)
  name String @db.VarChar(200)
  category String @db.VarChar(100)
  templateId String? @db.Uuid
  order Int @default(0)
  isActive Boolean @default(true)
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  tasks Task[]
  requirements MilestoneRequirement[]
  @@unique([projectId,code])
  @@map("task_type")
}
model Milestone {
  id String @id @db.Uuid
  projectId String @db.Uuid
  code String @db.VarChar(50)
  name String @db.VarChar(200)
  kind String @db.VarChar(20)
  sequence Int
  targetDate DateTime? @db.Date
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  requirements MilestoneRequirement[]
  @@unique([projectId,code])
  @@map("milestone")
}
model MilestoneRequirement {
  milestoneId String @db.Uuid
  taskTypeId String @db.Uuid
  milestone Milestone @relation(fields:[milestoneId],references:[id],onDelete:Cascade)
  taskType TaskType @relation(fields:[taskTypeId],references:[id],onDelete:Cascade)
  @@id([milestoneId,taskTypeId])
  @@map("milestone_requirement")
}
/// Planned work on a site, of one of the project's task types. Work orders —
/// checklists assigned to sites — are qc's, not tasks.
model Task {
  id String @id @db.Uuid
  projectId String @db.Uuid
  siteId String @db.Uuid
  taskTypeId String @db.Uuid
  templateId String? @db.Uuid
  title String @db.VarChar(250)
  status String @default("NOT_STARTED") @db.VarChar(30)
  assigneeId String? @db.Uuid
  plannedCompletionAt DateTime? @db.Timestamptz(6)
  actualCompletionAt DateTime? @db.Timestamptz(6)
  origin String @db.VarChar(20)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  site Site @relation(fields:[siteId],references:[id],onDelete:Cascade)
  taskType TaskType @relation(fields:[taskTypeId],references:[id],onDelete:Restrict)
  @@index([projectId,status])
  @@index([plannedCompletionAt])
  @@index([siteId])
  @@map("task")
}

/// Local projection of iam's authoritative scope grants, replicated over
/// JetStream on the `project-scope-cache` durable that STREAMS.IAM already
/// declared.
///
/// Written ONLY by the scope consumer, never by a request handler. A handler
/// that writes here has invented authority iam did not grant, and the two will
/// disagree about the same user until someone notices -- which, for an
/// authorization table, means until someone sees data they should not have.
///
/// Uniqueness is enforced by three partial indexes in migration.sql, not by an
/// `@@unique` here: PostgreSQL treats NULL as never equal to NULL in a unique
/// index, so a composite over the nullable columns would silently accept
/// unlimited duplicate global and project-scoped rows. Declaring an `@@unique`
/// as well would make `prisma migrate dev` try to "correct" the partial
/// indexes away. Same hazard, same fix as iam's UserRole.
model UserScope {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  level     String   @db.VarChar(10)
  projectId String?  @db.Uuid
  siteId    String?  @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("user_scope")
}

/// Records that the scope projection has been populated at least once.
///
/// Distinguishes "this user genuinely has no scope" from "nothing has been
/// replicated yet". Both look like an empty user_scope table and they demand
/// opposite behaviour: the first denies correctly, the second must trigger a
/// rebuild.
model ProjectionWatermark {
  name      String   @id @db.VarChar(50)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("projection_watermark")
}

/// Embedded verbatim from OUTBOX_MODEL_SQL in @ipms/persistence, as every
/// service that publishes does.
///
/// A mutation writes its audit row in the same transaction as the change, so a
/// crash between commit and publish cannot lose it. Publishing to NATS directly
/// from a service method would: the process dies after the write lands and the
/// ledger never hears about a mutation that happened, which is the one thing an
/// append-only ledger must never do.
model OutboxEvent {
  id            String    @id @db.Uuid
  subject       String    @db.VarChar(100)
  payload       Json
  correlationId String    @db.VarChar(64)
  actorId       String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt   DateTime? @db.Timestamptz(6)

  @@index([publishedAt, createdAt])
  @@map("outbox_event")
}
