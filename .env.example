NODE_ENV=development
LOG_LEVEL=debug
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
IAM_DATABASE_URL=postgresql://ipms_iam:ipms_iam@localhost:5432/ipms_iam
AUDIT_DATABASE_URL=postgresql://ipms_audit:ipms_audit@localhost:5432/ipms_audit
PROJECT_DATABASE_URL=postgresql://ipms_project:ipms_project@localhost:5432/ipms_project
QC_DATABASE_URL=postgresql://ipms_qc:ipms_qc@localhost:5432/ipms_qc
MEDIA_DATABASE_URL=postgresql://ipms_media:ipms_media@localhost:5432/ipms_media
NOTIFICATION_DATABASE_URL=postgresql://ipms_notification:ipms_notification@localhost:5432/ipms_notification
IPMS_API_BASE_URL=http://127.0.0.1:3000

# Where qc reaches the project service directly for the site geofence lookup.
# Not via the gateway: the endpoint is under /internal/, which the gateway refuses.
PROJECT_INTERNAL_URL=http://127.0.0.1:3004

# Required by `pnpm --filter iam seed` to create the four demo accounts
# (admin, manager, qc, engineer), which it will only do under NODE_ENV
# development or test. Unset, the seed reconciles the permission catalog and
# the system roles and creates no credentials.
# IAM_DEMO_PASSWORD=
